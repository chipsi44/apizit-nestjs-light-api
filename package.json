{
  "name": "apizit-nestjs-light-api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Standalone nestjs light reference API.",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && node --test tests/api.test.cjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "supertest": "7.2.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "@types/node": "22.20.2",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0"
  }
}
